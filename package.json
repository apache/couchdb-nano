{
  "name": "nano",
  "description": "The official CouchDB client for Node.js",
  "main": "./dist/nano-cjs.js",
  "exports": {
    ".": {
      "types": "./lib/nano.d.ts",
      "import": "./dist/nano-esm.mjs",
      "require": "./dist/nano-cjs.js"
    }
  },
  "types": "./lib/nano.d.ts",
  "license": "Apache-2.0",
  "homepage": "http://github.com/apache/couchdb-nano",
  "repository": "http://github.com/apache/couchdb-nano",
  "version": "12.0.0",
  "author": "Apache CouchDB <dev@couchdb.apache.org> (http://couchdb.apache.org)",
  "keywords": [
    "couchdb",
    "data",
    "request",
    "json",
    "nosql",
    "micro",
    "nano",
    "database"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rolldown": "^1.2.16",
    "typescript": "^7.0.2",
    "undici": "^8.12.3"
  },
  "scripts": {
    "test": "tsc lib/nano.d.ts && node --experimental-test-coverage --test ./test/*.test.mjs",
    "build": "npx rolldown -c rolldown.config.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0"
  },
  "pre-commit": [
    "test"
  ]
}
